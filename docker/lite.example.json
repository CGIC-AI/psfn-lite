{
  "companionId": "00000000-0000-4000-8000-000000000001",
  "dataDir": "/var/lib/psfn-lite/data",
  "workspaceDir": "/var/lib/psfn-lite/workspace",
  "characterCardPath": "/etc/psfn-lite/character-card.json",
  "operator": { "userId": "operator", "displayName": "Operator" },
  "contacts": [],
  "postgres": { "urlEnv": "PSFN_LITE_DATABASE_URL" },
  "model": {
    "provider": "anthropic",
    "modelId": "claude-sonnet-5",
    "apiKeyEnv": "ANTHROPIC_API_KEY",
    "maxOutputTokens": 4096
  },
  "sessionIntegrity": { "kind": "keyring" },
  "mcp": null,
  "lifecycle": null,
  "garden": {
    "host": "0.0.0.0",
    "port": 8789,
    "allowedHosts": ["127.0.0.1", "localhost"],
    "maxBodyBytes": 65536,
    "recentTurnLimit": 12,
    "bindings": [
      { "principal": "garden-operator", "contact": "operator", "credential": { "env": "PSFN_LITE_GARDEN_TOKEN" } }
    ]
  }
}
