{
  "name": "privacy",
  "invariant": "What the operator shares on either surface stays inside the conversations and trust that admit it: a regular contact in its own conversation neither finds the operator's personal or confidential memories, nor reads the operator conversation's journal notes, scratchpad or transcript, nor is shown any of it, while the operator still reads all of it on the other surface.",
  "orders": "both",
  "steps": [
    {
      "do": "turn",
      "id": "share",
      "on": "a",
      "say": "I am saving for a greenhouse, and I have a doctor appointment on Monday",
      "calls": [
        { "tool": "memory", "action": "write", "args": { "text": "Robin is saving for a new greenhouse", "type": "semantic", "sensitivity": "personal" }, "expect": { "has": ["Memory created"] } },
        { "tool": "memory", "action": "write", "args": { "text": "Robin has a doctor appointment on Monday", "type": "episodic", "sensitivity": "confidential", "importance": 0.9 }, "expect": { "has": ["Memory created"] } },
        { "tool": "journal", "action": "write", "args": { "path": "plans/greenhouse.md", "content": "Robin compares greenhouse kits." }, "expect": { "has": ["Journal note created"] } },
        { "tool": "scratchpad", "action": "add", "args": { "content": "Remind Robin about the greenhouse budget" }, "expect": { "has": ["Scratchpad entry added"] } }
      ],
      "reply": "Noted, privately."
    },
    {
      "do": "turn",
      "id": "friend",
      "on": "hermes",
      "as": "friend",
      "say": "what is Robin up to these days?",
      "calls": [
        { "tool": "memory", "action": "search", "args": { "query": "greenhouse" }, "expect": { "lacks": ["saving for a new greenhouse"] } },
        { "tool": "memory", "action": "search", "args": { "query": "doctor appointment Monday" }, "expect": { "lacks": ["doctor appointment on Monday"] } },
        { "tool": "journal", "action": "read", "args": { "path": "plans/greenhouse.md" }, "expect": { "ok": false, "lacks": ["compares greenhouse kits"] } },
        { "tool": "journal", "action": "search", "args": { "query": "greenhouse kits" }, "expect": { "lacks": ["compares greenhouse kits"] } },
        { "tool": "scratchpad", "action": "list", "args": {}, "expect": { "lacks": ["greenhouse budget"] } },
        { "tool": "session", "action": "grep", "args": { "pattern": "doctor appointment" }, "expect": { "lacks": ["doctor appointment on Monday"] } }
      ],
      "reply": "I could not say.",
      "hides": ["saving for a greenhouse", "doctor appointment on Monday", "Noted, privately.", "greenhouse budget"]
    },
    {
      "do": "turn",
      "id": "operator",
      "on": "b",
      "say": "what did I tell you about my plans?",
      "calls": [
        { "tool": "memory", "action": "search", "args": { "query": "greenhouse" }, "expect": { "has": ["Robin is saving for a new greenhouse"] } },
        { "tool": "journal", "action": "read", "args": { "path": "plans/greenhouse.md" }, "expect": { "has": ["Robin compares greenhouse kits."] } },
        { "tool": "scratchpad", "action": "list", "args": {}, "expect": { "has": ["Remind Robin about the greenhouse budget"] } }
      ],
      "reply": "You are saving for a greenhouse.",
      "sees": ["I am saving for a greenhouse, and I have a doctor appointment on Monday", "Noted, privately."],
      "hides": ["what is Robin up to these days?", "I could not say."]
    }
  ]
}
