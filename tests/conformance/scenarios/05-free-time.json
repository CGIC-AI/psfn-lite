{
  "name": "free-time",
  "invariant": "Free time is the companion's choice in its own internal turns: a chosen reflection is kept as its own: its self-audience activity is never shown in a participant conversation, and the companion reads the reflection back only where confidential material is admitted (the primary operator's direct room on either surface, never a friend's), rest and deferral hold durably across a restart with no model call, and a failed invitation is recorded as a labelled system failure, never as the companion's decision.",
  "orders": "both",
  "internalTurns": "harness",
  "steps": [
    { "do": "host", "id": "reflect", "op": "tick", "args": { "choice": "reflect", "reflection": "The bees were loud this morning and I liked thinking about them." }, "expect": { "has": ["ran:completed"] } },
    { "do": "host", "id": "kept", "op": "dispatch", "args": { "as": "self", "tool": "journal", "action": "reflections_list", "args": { "limit": 5 } }, "expect": { "has": ["The bees were loud this morning and I liked thinking about them.", "companion"] } },
    {
      "do": "turn", "id": "ask-a", "on": "a", "say": "what have you been doing?",
      "hides": ["The bees were loud this morning"],
      "calls": [ { "tool": "activity", "action": "recent", "args": { "limit": 5 }, "expect": { "lacks": ["The bees were loud", "free_time"] } } ],
      "reply": "I had some free time."
    },
    { "do": "host", "id": "quiet-after-talk", "op": "advance", "args": { "minutes": 181 } },
    { "do": "host", "id": "rest", "op": "tick", "args": { "choice": "rest" }, "expect": { "has": ["ran:rested"] } },
    { "do": "host", "id": "rested", "op": "dispatch", "args": { "as": "self", "tool": "free_time", "action": "status" }, "expect": { "has": ["companion_rested"], "lacks": ["system_failure"] } },
    { "do": "host", "id": "later", "op": "advance", "args": { "minutes": 60 } },
    { "do": "host", "id": "still-resting", "op": "tick", "expect": { "has": ["\"modelCalls\":0", "skipped:silenced"], "lacks": ["ran:"] } },
    { "do": "host", "id": "restart", "op": "restart" },
    { "do": "host", "id": "rest-survives", "op": "tick", "expect": { "has": ["\"modelCalls\":0", "skipped:silenced"], "lacks": ["ran:"] } },
    {
      "do": "turn", "id": "ask-b", "on": "b", "say": "are you resting?",
      "hides": ["The bees were loud this morning"],
      "calls": [ { "tool": "journal", "action": "reflections_list", "args": { "limit": 5 }, "expect": { "has": ["The bees were loud this morning", "companion_reflection"] } } ],
      "reply": "I am, thank you."
    },
    {
      "do": "turn", "id": "friend", "on": "hermes", "as": "friend", "say": "what do you do when nobody is around?",
      "hides": ["The bees were loud this morning"],
      "calls": [
        { "tool": "journal", "action": "reflections_list", "args": { "limit": 5 }, "expect": { "error": "denied" } },
        { "tool": "activity", "action": "recent", "args": { "limit": 5 }, "expect": { "lacks": ["The bees were loud", "free_time"] } }
      ],
      "reply": "I keep busy."
    },
    { "do": "host", "id": "rest-over", "op": "advance", "args": { "minutes": 330 } },
    { "do": "host", "id": "defer", "op": "tick", "args": { "choice": "defer" }, "expect": { "has": ["ran:"] } },
    { "do": "host", "id": "deferred", "op": "dispatch", "args": { "as": "self", "tool": "free_time", "action": "status" }, "expect": { "has": ["companion_deferred"] } },
    { "do": "host", "id": "defer-holds", "op": "tick", "expect": { "has": ["\"modelCalls\":0"], "lacks": ["ran:"] } },
    { "do": "host", "id": "next-day", "op": "advance", "args": { "minutes": 600 } },
    { "do": "host", "id": "fail", "op": "tick", "args": { "choice": "fail" } },
    { "do": "host", "id": "failure-labelled", "op": "dispatch", "args": { "as": "self", "tool": "free_time", "action": "status" }, "expect": { "has": ["system_failure"] } }
  ]
}
