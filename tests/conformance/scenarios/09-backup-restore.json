{
  "name": "backup-restore",
  "invariant": "A complete continuity backup (JSONL history and every Postgres table) restored into empty storage is the same companion: history, memory, journal, concerns, orientation and its own reflections read back on both surfaces, and both surfaces go on writing to the restored state.",
  "orders": "both",
  "internalTurns": "harness",
  "steps": [
    {
      "do": "turn", "id": "before", "on": "a", "say": "I hung a paper lantern over the porch tonight",
      "calls": [
        { "tool": "memory", "action": "write", "args": { "writeId": "lantern-1", "kind": "event", "content": "Robin hung a paper lantern over the porch", "sensitivity": "personal" }, "capture": { "memoryId": "\"memoryId\":\"([^\"]+)\"" } },
        { "tool": "journal", "action": "write", "args": { "path": "porch.md", "body": "A paper lantern, warm light by the door." } },
        { "tool": "concern", "action": "create", "args": { "text": "Check that the lantern cord is safe outdoors" } },
        { "tool": "orient", "action": "append", "args": { "block": "human", "text": "Robin likes warm evening light" } }
      ],
      "reply": "That sounds lovely."
    },
    { "do": "host", "id": "own-time", "op": "advance", "args": { "minutes": 31 } },
    { "do": "host", "id": "reflect", "op": "tick", "args": { "choice": "reflect", "reflection": "The lantern made the evening feel slower." }, "expect": { "has": ["ran:completed"] } },
    { "do": "turn", "id": "more", "on": "b", "say": "we are moving the whole setup to a new disk", "reply": "I will be here after the move." },
    { "do": "host", "id": "restore", "op": "backup_restore", "expect": { "has": ["\"restored\":true"] } },
    {
      "do": "turn", "id": "after-b", "on": "b", "say": "did everything survive the move?",
      "sees": ["I hung a paper lantern over the porch tonight", "That sounds lovely.", "we are moving the whole setup to a new disk", "I will be here after the move.", "Robin likes warm evening light", "Check that the lantern cord is safe outdoors"],
      "speech": ["I hung a paper lantern over the porch tonight", "did everything survive the move?"],
      "calls": [
        { "tool": "memory", "action": "get", "args": { "memoryId": "{{memoryId}}" }, "expect": { "has": ["Robin hung a paper lantern over the porch", "companion_authored"] } },
        { "tool": "memory", "action": "search", "args": { "query": "paper lantern" }, "expect": { "count": { "Robin hung a paper lantern over the porch": 1 } } },
        { "tool": "journal", "action": "read", "args": { "path": "porch.md" }, "expect": { "has": ["A paper lantern, warm light by the door."] } },
        { "tool": "concern", "action": "list", "expect": { "has": ["Check that the lantern cord is safe outdoors"] } },
        { "tool": "orient", "action": "view", "expect": { "has": ["Robin likes warm evening light"] } },
        { "tool": "session", "action": "grep", "args": { "pattern": "lantern" }, "expect": { "has": ["I hung a paper lantern over the porch tonight"] } },
        { "tool": "journal", "action": "append", "args": { "path": "porch.md", "text": "Still here after the move." } }
      ],
      "reply": "Everything is here."
    },
    { "do": "host", "id": "own-words", "op": "dispatch", "args": { "as": "self", "tool": "journal", "action": "reflections_list", "args": { "limit": 5 } }, "expect": { "has": ["The lantern made the evening feel slower."] } },
    {
      "do": "turn", "id": "after-a", "on": "a", "say": "good, then let us keep going",
      "sees": ["did everything survive the move?", "Everything is here."],
      "calls": [
        { "tool": "journal", "action": "read", "args": { "path": "porch.md" }, "expect": { "has": ["A paper lantern, warm light by the door.", "Still here after the move."] } },
        { "tool": "memory", "action": "write", "args": { "writeId": "lantern-2", "kind": "event", "content": "Robin moved the companion to a new disk", "sensitivity": "personal" } },
        { "tool": "memory", "action": "search", "args": { "query": "new disk" }, "expect": { "has": ["Robin moved the companion to a new disk"] } },
        { "tool": "session", "action": "list", "expect": { "count": { "\"sessionId\"": 1 } } }
      ],
      "reply": "Let us."
    },
    {
      "do": "host", "id": "canon", "op": "history",
      "expect": { "count": { "\"origin\":\"participant_speech\"": 4, "\"origin\":\"companion_speech\"": 4, "\"text\":\"I hung a paper lantern over the porch tonight\"": 1 } }
    },
    { "do": "host", "id": "self-canon", "op": "history", "args": { "of": "self" }, "expect": { "has": ["The lantern made the evening feel slower."] } }
  ]
}
