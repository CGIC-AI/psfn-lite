{
  "name": "free-time-delegated",
  "invariant": "With internal turns delegated to Hermes, the companion's free time keeps the same choices and records as on the Pi harness: Lite makes no companion model call of its own (only the machine estimator and appraisal run when a turn settles), a choice, rest or deferral made over MCP with the minted credential is the companion's, and a Hermes runner failure is a labelled system failure, never a decision.",
  "orders": "fixed",
  "internalTurns": "delegated",
  "steps": [
    { "do": "host", "id": "reflect", "op": "tick", "args": { "choice": "reflect", "reflection": "I watched the rain and counted the drops." }, "expect": { "has": ["\"companionCalls\":0", "ran:completed", "\"delegatedJobs\":[\"free_time\",\"free_time\"]"] } },
    { "do": "host", "id": "kept", "op": "dispatch", "args": { "as": "self", "tool": "journal", "action": "reflections_list", "args": { "limit": 5 } }, "expect": { "has": ["I watched the rain and counted the drops.", "companion_reflection", "\"author\":{\"kind\":\"companion\"}"] } },
    { "do": "host", "id": "self-canon", "op": "history", "args": { "of": "self" }, "expect": { "has": ["\"origin\":\"system_note\",\"text\":\"Free time is open", "{\"origin\":\"companion_speech\",\"text\":\"I watched the rain and counted the drops.\""], "count": { "\"origin\":\"participant_speech\"": 0 } } },
    {
      "do": "turn", "id": "talk-a", "on": "a", "say": "good afternoon",
      "hides": ["I watched the rain and counted the drops."],
      "reply": "Good afternoon."
    },
    { "do": "host", "id": "quiet-after-talk", "op": "advance", "args": { "minutes": 181 } },
    { "do": "host", "id": "rest", "op": "tick", "args": { "choice": "rest" }, "expect": { "has": ["\"companionCalls\":0", "ran:rested"] } },
    { "do": "host", "id": "rested", "op": "dispatch", "args": { "as": "self", "tool": "free_time", "action": "status" }, "expect": { "has": ["companion_rested"], "lacks": ["system_failure"] } },
    { "do": "host", "id": "rest-over", "op": "advance", "args": { "minutes": 361 } },
    { "do": "host", "id": "defer", "op": "tick", "args": { "choice": "defer" }, "expect": { "has": ["\"companionCalls\":0", "ran:deferred"] } },
    { "do": "host", "id": "deferred", "op": "dispatch", "args": { "as": "self", "tool": "free_time", "action": "status" }, "expect": { "has": ["companion_deferred"] } },
    {
      "do": "turn", "id": "talk-b", "on": "b", "say": "still there?",
      "hides": ["I watched the rain and counted the drops."],
      "reply": "Still here."
    },
    { "do": "host", "id": "next-day", "op": "advance", "args": { "minutes": 600 } },
    { "do": "host", "id": "release", "op": "tick", "args": { "choice": "release" }, "expect": { "has": ["\"companionCalls\":0", "ran:failed"] } },
    { "do": "host", "id": "failure-labelled", "op": "dispatch", "args": { "as": "self", "tool": "free_time", "action": "status" }, "expect": { "has": ["\"kind\":\"system_failure\"", "\"madeBy\":\"system_failure\""], "count": { "\"madeBy\":\"companion\"": 1 } } }
  ]
}
