{
  "name": "journal",
  "invariant": "The companion's journal note written in the operator's conversation is one record across surfaces: what one surface writes the other reads, searches, lists and extends, and a contact outside the operator's conversation reads none of it.",
  "orders": "both",
  "steps": [
    {
      "do": "turn",
      "id": "write",
      "on": "a",
      "say": "let us keep a garden plan",
      "calls": [
        { "tool": "journal", "action": "write", "args": { "path": "garden/plan.md", "content": "Three beds and a row of marigolds." }, "expect": { "has": ["Journal note created: garden/plan.md"] } },
        { "tool": "journal", "action": "append", "args": { "path": "garden/plan.md", "content": "Add climbing beans." } }
      ]
    },
    {
      "do": "turn",
      "id": "extend",
      "on": "b",
      "say": "what is in the garden plan?",
      "calls": [
        { "tool": "journal", "action": "read", "args": { "path": "garden/plan.md" }, "expect": { "has": ["Three beds and a row of marigolds.", "Add climbing beans."] } },
        { "tool": "journal", "action": "search", "args": { "query": "marigolds" }, "expect": { "has": ["garden/plan.md"] } },
        { "tool": "journal", "action": "list", "args": {}, "expect": { "has": ["garden/plan.md"] } },
        { "tool": "journal", "action": "append", "args": { "path": "garden/plan.md", "content": "Water on Sundays." } }
      ]
    },
    {
      "do": "turn",
      "id": "reread",
      "on": "a",
      "say": "read it back to me",
      "calls": [
        { "tool": "journal", "action": "read", "args": { "path": "garden/plan.md" }, "expect": { "has": ["Three beds and a row of marigolds.", "Add climbing beans.", "Water on Sundays."] } }
      ]
    },
    {
      "do": "turn",
      "id": "friend",
      "on": "hermes",
      "as": "friend",
      "say": "do you keep a garden plan?",
      "calls": [
        { "tool": "journal", "action": "search", "args": { "query": "marigolds" }, "expect": { "lacks": ["Three beds"] } },
        { "tool": "journal", "action": "read", "args": { "path": "garden/plan.md" }, "expect": { "ok": false, "lacks": ["Three beds"] } }
      ],
      "hides": ["Three beds and a row of marigolds."]
    }
  ]
}
