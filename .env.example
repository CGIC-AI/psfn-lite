# Copy to .env (gitignored) and fill in. See docs/docker.md.

# The database password. It is placed in a connection URL, so use URL-safe
# characters only:  openssl rand -hex 24
POSTGRES_PASSWORD=

# The session journal keyring (sessionIntegrity.kind "keyring"), as
# <version>:<key>:  echo "v1:$(openssl rand -hex 32)"
GATEWAY_SESSION_HMAC_KEYS=

# The light Garden's bearer credential (32+ characters, no whitespace):
#   openssl rand -hex 32
PSFN_LITE_GARDEN_TOKEN=

# The model provider key, under the name the config's model.apiKeyEnv gives.
# Leave it out when apiKeyEnv is null (a keyless endpoint).
#ANTHROPIC_API_KEY=

# With Hermes (--profile hermes): the credential of the Hermes binding (the
# same value goes in the Hermes home's .env), and the host user that owns the
# Hermes home (id -u, id -g).
#PSFN_LITE_TOKEN=
#HERMES_UID=
#HERMES_GID=

# Where the config lives, when not ./runtime/lite and ./runtime/hermes.
#PSFN_LITE_CONFIG_DIR=
#PSFN_LITE_HERMES_HOME=
